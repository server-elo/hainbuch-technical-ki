# HAINBUCH Clone — copy to .env (never commit .env)
# Backend: node lite-server.cjs   Frontend: npx vite build

# VibeProxy / OpenAI-compatible LLM endpoint
LLM_URL=http://127.0.0.1:8317/v1/chat/completions
MODEL_ID=gemini-3.8-flash-medium

# Public base URL of the backend (tunnel URL in production!).
# Photo URLs baked into answers use this — localhost default breaks live images.
BASE_URL=http://localhost:3002

# Shared speed-bump for /api/chat + /api/feedback (ships in VITE bundle = public, not a secret)
APP_KEY=
# Required for /api/admin even on loopback when set (set this!)
ADMIN_KEY=

# Cost protection (global caps — tunnel visitors share one bucket)
RATE_MAX_PER_HOUR=120
RATE_MAX_PER_DAY=800
FEEDBACK_MAX_PER_HOUR=60
# NEVER set TRUST_LOOPBACK=1 on a tunneled host (exempts all public traffic)
TRUST_LOOPBACK=0

# Data overrides (defaults point into the repo)
#KB_PATH=./data/hainbuch_products.json
#IMG_PATH=./hainbuch-images.json
#SHOP_JSON=./catalog/shop_accessories.json
#CATALOG_JSON=./catalog/products_de.json
#MAP_JSON=./catalog/map.json
#SHOP_DIR=./catalog/shop

PORT=3002
